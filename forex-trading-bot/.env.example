# ==============================================================================
# QuantAI Autonomous Trading Platform - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the active .env file to public version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 Server & Security Settings
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=development  # development, test, or production
LOG_LEVEL=INFO

# Cryptographic token signing secret (generate with: openssl rand -hex 32)
AUTH_SECRET_KEY=change_this_to_a_random_32_byte_secret_hex_in_production
TOKEN_EXPIRY_SECONDS=43200

# Strict Live Trading Safety Gate (MUST be false until all acceptance gates pass)
ALLOW_LIVE_TRADING=false

# Initial RBAC Seed Passwords (must be updated on initial boot)
ADMIN_INITIAL_PASSWORD=ChangeAdminPassword2026!
TRADER_INITIAL_PASSWORD=ChangeTraderPassword2026!
VIEWER_INITIAL_PASSWORD=ChangeViewerPassword2026!

# Database Path (defaults to /app/data/quant_trade_ledger.db in Docker)
SQLITE_DB_PATH=data/quant_trade_ledger.db

# ------------------------------------------------------------------------------
# 🧠 Google Gemini AI Configuration (Optional: For macro & narrative context)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 📈 MetaTrader 5 Broker Configuration (Optional: For MT5 Demo/Live)
# ------------------------------------------------------------------------------
MT5_ACCOUNT=0
MT5_PASSWORD=your_mt5_password_here
MT5_SERVER=MetaQuotes-Demo
MT5_MAGIC_NUMBER=10001

# ------------------------------------------------------------------------------
# 🪙 Binance Crypto Exchange Configuration (Optional: For Spot/Futures Testnet)
# ------------------------------------------------------------------------------
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_TESTNET=True
