# ==============================================================================
# QuantAI Autonomous Trading Bot - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the active .env file to public version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 Server & Web Telemetry Settings (Required for AWS EC2 Deployment)
# ------------------------------------------------------------------------------
# Use 0.0.0.0 for AWS EC2 / Docker containers so it listens on all interfaces
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 🧠 Google Gemini AI Configuration (Required for AI Analysis & Veto Engine)
# ------------------------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 📈 MetaTrader 5 Broker Configuration (Optional: For MT5 Forex / Gold Trading)
# ------------------------------------------------------------------------------
# Note: MT5 terminal execution is native on Windows. In Linux / Docker, the bot
# operates seamlessly in Paper Trading simulation or via REST/WebSocket bridges.
MT5_ACCOUNT=0
MT5_PASSWORD=your_mt5_password_here
MT5_SERVER=MetaQuotes-Demo
MT5_MAGIC_NUMBER=10001

# ------------------------------------------------------------------------------
# 🪙 Binance Crypto Exchange Configuration (Optional: For Crypto Live / Demo)
# ------------------------------------------------------------------------------
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET=True
