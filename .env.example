# ==============================================================================
# QuantAI Autonomous Trading Bot - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the active .env file to public version control!
# ==============================================================================

# Server & Web Telemetry Settings (Required for AWS EC2 Deployment)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# MetaTrader 5 Broker Configuration (Optional)
MT5_ACCOUNT=0
MT5_PASSWORD=your_mt5_password_here
MT5_SERVER=MetaQuotes-Demo
MT5_MAGIC_NUMBER=10001

# Binance Crypto Exchange Configuration (Optional)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET=True
